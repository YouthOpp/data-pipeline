{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "YouthOpp canonical record v2 (v1-compatible)",
  "type": "object",
  "required": [
    "id",
    "title",
    "url",
    "source",
    "source_url",
    "created_at",
    "updated_at",
    "first_seen_at",
    "last_seen_at",
    "last_checked_at",
    "published_at",
    "deadline",
    "location",
    "language",
    "summary",
    "tags",
    "host_countries",
    "eligible_countries",
    "category",
    "status",
    "categories",
    "kind",
    "classification",
    "publisher_country"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "url": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "updated_at": {
      "type": "string",
      "minLength": 1
    },
    "first_seen_at": {
      "type": "string",
      "minLength": 1
    },
    "last_seen_at": {
      "type": "string",
      "minLength": 1
    },
    "last_checked_at": {
      "type": "string",
      "minLength": 1
    },
    "published_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "deadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "location": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "summary": {
      "type": "string",
      "maxLength": 600
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "host_countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "eligible_countries": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Z]{2}$"
      }
    },
    "category": {
      "enum": [
        "scholarships",
        "internships",
        "volunteering",
        "fellowships",
        "training",
        "competitions",
        "grants",
        "jobs",
        "other"
      ]
    },
    "status": {
      "enum": [
        "open",
        "expired",
        "unknown"
      ]
    },
    "categories": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "scholarships",
          "internships",
          "volunteering",
          "fellowships",
          "training",
          "competitions",
          "grants",
          "jobs",
          "other"
        ]
      }
    },
    "kind": {
      "enum": [
        "opportunity",
        "programme-overview",
        "institutional-grant",
        "unknown"
      ]
    },
    "publisher_country": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2}$"
    },
    "classification": {
      "type": "object",
      "required": [
        "method",
        "status",
        "evidence"
      ],
      "properties": {
        "method": {
          "type": "string"
        },
        "status": {
          "enum": [
            "classified",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
